# Copiar para .env e preencher. O .env nunca vai para o chat nem para o git.

NEON_DATABASE_URL=postgresql://utilizador:senha@servidor/base?sslmode=require

# Classificação em produção
PROMPT_VERSION=c05r
BACKEND=ollama                 # ollama | anthropic | openai
MODELO=gemma4:26b             # o modelo escolhido na avaliação (Cap. 6)
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Onde o ERP deixa as extrações (visitas_*.xlsx, linhas_faturas_*.xlsx, equipamentos_*.xlsx)
ERP_PASTA=C:\SAD\extracoes

# Dashboard
SESSAO_HORAS=12
COOKIE_SEGURO=0                # 1 quando servido por HTTPS

# Benchmark
ENTRADA_VERSION=v3
